#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int len, i, half, isSame = 1;

    printf("Enter a string: ");
    scanf("%s", str);

    len = strlen(str);

    // If odd length → cannot be same
    if (len % 2 != 0) {
        printf("DIFFERENT\n");
        return 0;
    }

    half = len / 2;

    // Compare first half with second half
    for (i = 0; i < half; i++) {
        if (str[i] != str[i + half]) {
            isSame = 0;
            break;
        }
    }

    if (isSame)
        printf("SAME\n");
    else
        printf("DIFFERENT\n");

    return 0;
}
